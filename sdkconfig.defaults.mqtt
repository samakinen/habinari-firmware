# Wi-Fi/MQTT personality — the aux-powered variant.
#
# Build it alongside the KNX one rather than instead of it:
#
#   tools/build_variants.sh mqtt
#
# KNX is off, and the build enforces that it stays off: the bit-banged TP1
# receiver has about a microsecond of sampling margin left and a radio stack
# will spend it. See main/src/protocol_registry.c.
#
# This variant needs the 5-30 V auxiliary supply on the secondary connector.
# It will not run on KNX bus power.
# CONFIG_SENSOR_BOARD_PROTOCOL_KNX is not set
CONFIG_SENSOR_BOARD_PROTOCOL_MODBUS=y
CONFIG_SENSOR_BOARD_PROTOCOL_MQTT=y

CONFIG_SENSOR_BOARD_MQTT_BASE_TOPIC="sensorboard"
CONFIG_SENSOR_BOARD_MQTT_DISCOVERY_PREFIX="homeassistant"
CONFIG_SENSOR_BOARD_MQTT_STATE_INTERVAL_S=10

# The KNX bit-timing options in sdkconfig.defaults are inert without the KNX
# personality, but the driver they configure is not built either, so leave them.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
