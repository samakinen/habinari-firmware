# Build trees. One per field-bus personality; see tools/build_variants.sh.
/build/
/build_*/

# ESP-IDF generated configuration and dependencies
dependencies.lock
managed_components/
sdkconfig
sdkconfig.old
sdkconfig.prod
dependencies/*

# Build artefacts, not sources: regenerated by every build from
# main/include/knx_product.hpp.
/ets_export/

# Bosch BSEC is proprietary and redistribution-forbidden — never commit it.
# See components/bsec2/README.md and THIRD-PARTY-NOTICES.md.
components/bsec2/bosch/

# Editor / tooling
.vscode/
.cache
.claude
compile_commands.json

# Python
venv/
.env/
.mypy_cache/
__pycache__/

/docs/The KNX Standard v3.0.0

# Host binary the nested tools/ets_export build drops next to its own sources:
# KNstaX puts product_exporter under the top-level project's source dir, which
# is tools/ets_export when that project is configured on its own.
/tools/ets_export/tools/
