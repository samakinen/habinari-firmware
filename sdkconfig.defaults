# The board is an ESP32-C6. Stating the target here rather than relying on
# `idf.py set-target` means a fresh clone builds the right binary: without it
# the build silently falls back to the plain ESP32 default.
CONFIG_IDF_TARGET="esp32c6"

# Shared across every variant on purpose (see main/Kconfig.projbuild): the BLE
# advertisement and the Home Assistant device card both fall back to this when
# nobody has set an install name yet, so a modbus-ble image and an mqtt image
# should agree on it.
#
# CAUTION: this string shares the 24-byte BLE advertisement buffer with a
# space and six hex digits — 24 chars is already one past what fits alongside
# them, so every unconfigured board advertises the same truncated name
# ("Habinari HVAC Controlle") until it is given a real one, instead of a name
# that tells them apart. Shorten it (default was "HVAC Controller", 16 chars,
# which fits with 7 to spare) if that BLE window matters for commissioning a
# room full of boards at once.
CONFIG_HABINARI_DEVICE_NAME_PREFIX="Habinari"

# The board's KNX physical layer is the STKNX transceiver driven by the
# bit-banging backend. Bit-bang is the only KNX_TP1_PHYSICAL choice, but it is
# stated anyway: every CONFIG_KNX_TP1_BITBANG_* option below depends on it, and
# would be silently dropped if a future backend became the default.
CONFIG_KNX_MEDIUM_TP1=y
CONFIG_KNX_TP1_BITBANG=y
CONFIG_KNX_TP1_BITBANG_TX_PIN=4
CONFIG_KNX_TP1_BITBANG_RX_PIN=5
# CONFIG_KNX_TP1_BITBANG_RX_PULLUP is not set
CONFIG_KNX_TP1_BITBANG_TX_DOMINANT_HIGH=y
CONFIG_KNX_TP1_BITBANG_RX_DOMINANT_HIGH=y
# Mid-bit-cell sampling. A received bit is decoded from the sticky flag the RX
# edge ISR sets, not from the bus level, so this point only has to sit between
# this cell's edge and the next one — it does NOT have to be inside the 35 µs
# dominant pulse. At 70 µs a sampling alarm more than 34 µs late already landed
# past the following cell's edge and stole its bit; measured ISR jitter on this
# board peaked at 51 µs. 52 µs splits the 104 µs cell evenly and doubles the
# late-alarm tolerance.
CONFIG_KNX_TP1_BITBANG_SAMPLE_OFFSET_US=52
# The start-bit re-read has a harder limit than the sample point: it must land
# while the bus is still dominant, i.e. within zeroActiveTimeUs (35 µs) of the
# edge, minus GPIO-ISR entry latency and timer lateness. Held at the Kconfig
# minimum on purpose — the trade is glitch rejection against latency tolerance,
# and on this board latency is the failure mode. driver.linkCounters()
# .startValidationRejects says whether it needs to go the other way.
CONFIG_KNX_TP1_BITBANG_START_BIT_VALIDATION_US=5
# ESP_INTR_FLAG_LEVEL3 — matches the gptimer interrupt priority so the RX edge
# and bit-timer ISRs cannot preempt each other. ESP_INTR_FLAG_IRAM is added
# unconditionally by the driver itself and must not be relied on from here.
CONFIG_KNX_TP1_BITBANG_ISR_SERVICE_FLAGS=8
# STKNX KNX_OK on PIN_KNX_OK (GPIO3), see main/include/board.h.
# Polarity below assumes the transceiver drives the pin high while the bus
# supply is good; flip to "is not set" if the schematic says otherwise.
CONFIG_KNX_TP1_BITBANG_LINK_PIN=3
CONFIG_KNX_TP1_BITBANG_LINK_ACTIVE_HIGH=y
# CONFIG_KNX_TP1_BITBANG_LINK_PULLUP is not set
CONFIG_KNX_TP1_BITBANG_LINK_DOWN_DEBOUNCE_US=20000
CONFIG_KNX_TP1_BITBANG_LINK_UP_DEBOUNCE_US=200000
# This board holds 3V3 up for seconds on bulk capacitance after the bus dies,
# so the debounced task-context notification arrives with time to spare and the
# interrupt-context power-fail hook is not needed. Enable it on a redesign with
# a shorter hold-up time.
# CONFIG_KNX_TP1_BITBANG_LINK_POWERFAIL_ISR is not set
CONFIG_GPTIMER_ISR_HANDLER_IN_IRAM=y
CONFIG_GPTIMER_CTRL_FUNC_IN_IRAM=y
# Adds ESP_INTR_FLAG_IRAM to the gptimer interrupt. Without it the bit-timing
# alarm is masked for the whole duration of a flash erase/write (NVS commit on
# an ETS download), which stretches or drops whichever TP1 bit was mid-flight.
# The two options above are what make it legal: the alarm callback and the
# gptimer_set_alarm_action()/gptimer_get_raw_count() calls the ISR makes are
# then all IRAM-resident.
CONFIG_GPTIMER_ISR_CACHE_SAFE=y
# KNX Data Secure (AN158): the Security Interface Object, the Tool Key, the
# key tables, sequence-number persistence and the CCM transforms on the
# receive and send paths. Stated here, in the base every variant layers on,
# because the TP1 image is this file alone and the product declares itself
# Data Secure capable on both media (SecurityPolicy in main/include/
# knx_product.hpp; the .knxprod says SecureEnabled="true"). Without it the TP1
# catalogue entry promised security the image did not link: a secure ETS
# download would have found no Security Interface Object and no S-A_Sync
# answer. The non-KNX variants compile the option but link none of it.
#
# Only the AES block cipher comes from the IDF (esp_aes, hardware); CCM is the
# stack's own. TP1 has no tunnelling client, so the mbedTLS 4 restriction on
# IP Secure sessions (see the KNstaX Kconfig) does not touch this image.
CONFIG_KNX_ENABLE_SECURITY=y
# The receive task (knx_tp1_rx) runs the Data Secure transforms. Static report
# for this image with security on (tools/stack_report.py, November 2026, -Og):
# deepest resolved chain 6,128 B over 54 frames, a management response
# encrypted on the RX task (ccmEncrypt 784 B; ccmDecrypt is 912 B on a
# shallower path), of which 5.1 KB is the stack and the rest the IDF's AES
# lock/heap/log tail. A lower bound under the 6.5 KB bench threshold of the
# sizing rule (docs/code-review-2026-10-fix-design.md, 3.8h), so 8192 — the
# Kconfig maximum — stays until the bench says otherwise.
CONFIG_KNX_RX_TASK_STACK_SIZE=8192
# Bring-up default: compile in KNX_LOGD so the per-frame RX/TX dumps exist.
# The runtime level is already set to Debug in knx_service.cpp; without this
# compile-time gate at 4 those calls are compiled out and nothing is logged.
# Production (sdkconfig.defaults.prod) drops it back to 3.
CONFIG_KNX_LOG_LEVEL=4
# Every variant layers its overlay on top of this file, so the flash size and
# partition table are stated here only.
# Board has 4 MB flash; the default 2 MB left half of it unreachable.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
# Two OTA app slots + larger NVS; see partitions.csv for the rationale.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
