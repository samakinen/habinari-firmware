# Out-of-band service channel over BLE.
#
# An overlay, not a variant: it is layered on top of a personality's defaults
# because it is not a personality itself (see main/include/oob_service.h). It
# composes with the Modbus and MQTT defaults and with nothing else — a KNX image
# cannot select CONFIG_HABINARI_OOB_BLE at all, and Kconfig says why.
#
#   tools/build_variants.sh modbus-ble
#   tools/build_variants.sh mqtt
CONFIG_HABINARI_OOB_BLE=y

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y

# One connection, and no client role. This device is commissioned by one person
# standing in front of it; it never initiates, never scans and never needs a
# second link. Every one of these settings is memory the room controller keeps.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n

# LE Secure Connections with MITM protection. The passkey is derived per device
# from the eFuse root secret and printed on the label, so "display only" is the
# truthful I/O capability and Just Works pairing is never negotiated.
CONFIG_BT_NIMBLE_SM_LEGACY=n
CONFIG_BT_NIMBLE_SM_SC=y

# Bonds in NVS, so a second visit does not re-pair — and so a factory reset,
# which erases NVS, also revokes every client that was ever trusted.
CONFIG_BT_NIMBLE_NVS_PERSIST=y

# The default 23-byte ATT payload would fragment a 129-character broker URI into
# a long write and a descriptor read into three round trips. 247 is what a
# modern client offers anyway and costs one buffer.
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247

# The device advertises only inside a commissioning window, so a resolvable
# private address buys nothing an installer would notice and costs the ability
# to identify a board by its address in a scan.
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n
